# ==========================================
# BOYA Platform — Environment Variables
# ==========================================

# Server Configuration
PORT=3000
NODE_ENV="development" # "development" | "production"

# PostgreSQL Database Configuration
DATABASE_URL="postgresql://user:password@host:5432/boyadb"

# Optional Direct PostgreSQL Parameters (alternative to DATABASE_URL)
SQL_HOST="localhost"
SQL_USER="postgres"
SQL_PASSWORD="password"
SQL_DB_NAME="boyadb"
SQL_PORT=5432
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="password"

# Database Seeding flag (set to true to run initial database seed on startup)
RUN_SEED="false"

# JWT Secret Key for Authentication Tokens (HMAC-SHA256)
JWT_SECRET="your_cryptographically_secure_jwt_secret_key_here"

# MeliPayamak SMS Gateway Configuration (for Iranian mobile OTP & booking alerts)
MELIPAYAMAK_USERNAME="your_melipayamak_username"
MELIPAYAMAK_PASSWORD="your_melipayamak_password"
MELIPAYAMAK_FROM_NUMBER="50004000..."

# Optional Redis Cache / Distributed Rate Limiter
REDIS_URL="redis://localhost:6379"

# Vite / Developer Environment Flags
DISABLE_HMR="false"
