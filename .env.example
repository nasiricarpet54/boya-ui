# Database Configuration
DATABASE_URL="postgresql://user:password@host:5432/boyadb"

# JWT Secret Key for Authentication
JWT_SECRET="your_jwt_secret_key_here"

# Comma-separated exact origins allowed to use credentialed browser requests.
# Replace with the exact production frontend origin(s) before deployment.
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# MeliPayamak SMS Gateway Configuration
MELIPAYAMAK_USERNAME="your_melipayamak_username"
MELIPAYAMAK_PASSWORD="your_melipayamak_password"
MELIPAYAMAK_FROM_NUMBER="50004000..."

# Server Port
PORT=3000
